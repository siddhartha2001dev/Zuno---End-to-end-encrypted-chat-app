PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/zuno_chat?retryWrites=true&w=majority
JWT_SECRET=super-secret-jwt-key-for-realtime-chat-app-development-32chars
CORS_ORIGIN=http://localhost:5173
