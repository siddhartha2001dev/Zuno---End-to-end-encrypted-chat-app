# ==============================================================================
# Zuno Chat - Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# Server Configuration
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/zuno_chat?retryWrites=true&w=majority
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Cloudinary Configuration (For Avatars & File/Media Attachments)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (formerly Sendinblue) Configuration (For Transactional Verification Emails)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@domain.com
BREVO_SENDER_NAME=ZunoChat
